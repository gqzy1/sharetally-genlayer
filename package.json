{
  "name": "sharetally-genlayer",
  "version": "1.0.0",
  "description": "Consensus-backed shared quotation costs, exact Shapley allocation and coalition exit checks",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "test": "python -m unittest discover -s tests -v && npm run test:sdk",
    "typecheck": "tsc --noEmit",
    "check:schema": "node --import tsx scripts/schema.ts",
    "deploy": "node --import tsx scripts/deploy.ts",
    "accept": "node --import tsx scripts/accept.ts",
    "test:sdk": "node --import tsx --test tests/sdk.test.ts",
    "accept:live": "node --import tsx scripts/live.ts",
    "verify:live": "node --import tsx scripts/milestone.ts",
    "verify:browser": "node scripts/browser-accept.mjs --read-only",
    "verify:milestone": "node --import tsx scripts/milestone.ts"
  },
  "keywords": [],
  "author": "chuanqi",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "genlayer-js": "2.0.0-rc.3"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "playwright": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "private": true
}
